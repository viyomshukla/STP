# ---- AI model settings (Groq, free) ----
# Get a free key at https://console.groq.com/keys and paste it below (in .env, not here).
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b

# ---- "Not covered" thresholds ----
# If the best search score is below this, we answer "not covered" without calling the AI.
# vector score = cosine similarity (0 to 1). keyword score = BM25 score (0 and up).
VECTOR_MIN_SCORE=0.30
KEYWORD_MIN_SCORE=4.0
